diff '--color=auto' -urN seamonkey-2.53.24.orig/third_party/python/setuptools/setuptools/_vendor/tomli/_parser.py seamonkey-2.53.24/third_party/python/setuptools/setuptools/_vendor/tomli/_parser.py

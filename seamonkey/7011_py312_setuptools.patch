+    venv.run(["python", "-c", "import pip"])
+    # disable index URL so bits and bobs aren't requested from PyPI
+    with contexts.environment(PYTHONPATH=None, PIP_NO_INDEX="1"):
+        _check_test_command_install_requirements(venv, tmpdir)

--- seamonkey-2.53.24.orig/third_party/python/setuptools/setuptools/_distutils/command/py37compat.py	1970-01-01 01:00:00.000000000 +0100
+++ seamonkey-2.53.24/third_party/python/setuptools/setuptools/_distutils/command/py37compat.py	2026-08-22 22:46:36.651824285 +0200
@@ -0,0 +1,31 @@
+import sys
+
+
+def _pythonlib_compat():
+    """
+    On Python 3.7 and earlier, distutils would include the Python
+    library. See pypa/distutils#9.
+    """
+    from distutils import sysconfig
+
+    if not sysconfig.get_config_var('Py_ENABLED_SHARED'):
+        return
+
+    yield 'python{}.{}{}'.format(
+        sys.hexversion >> 24,
+        (sys.hexversion >> 16) & 0xFF,
+        sysconfig.get_config_var('ABIFLAGS'),
+    )
+
+
+def compose(f1, f2):
+    return lambda *args, **kwargs: f1(f2(*args, **kwargs))
+
+
+pythonlib = (
+    compose(list, _pythonlib_compat)
+    if sys.version_info < (3, 8)
+    and sys.platform != 'darwin'
+    and sys.platform[:3] != 'aix'
+    else list
+)
diff '--color=auto' -urN seamonkey-2.53.24.orig/third_party/python/setuptools/setuptools/_distutils/command/register.py seamonkey-2.53.24/third_party/python/setuptools/setuptools/_distutils/command/register.py
--- seamonkey-2.53.24.orig/third_party/python/setuptools/setuptools/_distutils/command/register.py	1970-01-01 01:00:00.000000000 +0100
